# ---------------------------------------------------------------------------
# LLM-Assisted IT Audit Risk and Control Assessment System - example settings
#
# Copy to .env and edit.  NEVER commit a real .env or a real API key.
#   cp .env.example .env
# Every value below has a working default, so the application runs with no .env
# at all, fully offline, using the deterministic mock provider.
# ---------------------------------------------------------------------------

# ---- application ----------------------------------------------------------
ENVIRONMENT=development
DEBUG=false

# ---- database -------------------------------------------------------------
# SQLite by default. The schema is portable; to move to PostgreSQL use e.g.
# DATABASE_URL=postgresql+psycopg://audit:password@localhost:5432/itaudit
DATABASE_URL=sqlite:///./data/audit.db
DB_ECHO=false

# ---- LLM provider ---------------------------------------------------------
# "mock"   - offline, deterministic, rule-based. No API key, no network.
#            Use this to demonstrate the full workflow. Results measure the
#            pipeline, NOT language-model capability.
# "openai" - any OpenAI-COMPATIBLE endpoint (OpenAI, Azure gateways, OpenRouter,
#            Ollama, vLLM, LM Studio, llama.cpp server, ...).
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=          # leave unset for mock / for local servers that need no key
# LLM_BASE_URL=         # e.g. http://localhost:11434/v1  (Ollama)
#                       # e.g. http://localhost:8000/v1   (vLLM)
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2500
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_USE_JSON_MODE=true

# Research lever: fraction of MOCK assessments that deliberately fabricate a
# citation or an unsupported claim, so the validation layer can be exercised and
# measured offline. Keep at 0.0 for normal use.
MOCK_HALLUCINATION_RATE=0.0
MOCK_SEED=1337

# ---- embeddings -----------------------------------------------------------
# "local"  - stateless hashing vectoriser. Deterministic, no network.
# "openai" - remote embedding endpoint (uses EMBEDDING_API_KEY / _BASE_URL).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# ---- retrieval (RAG) ------------------------------------------------------
RETRIEVAL_STRATEGY=HYBRID        # KEYWORD | VECTOR | HYBRID
RETRIEVAL_TOP_K=12
RETRIEVAL_CANDIDATE_K=60
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
TABLE_ROWS_PER_CHUNK=25
MAX_EVIDENCE_CHARS=24000
RAW_EVIDENCE_CHAR_BUDGET=24000

# ---- assessment safety rails ---------------------------------------------
# Human review is mandatory by design; leaving this true is the supported mode.
FORCE_HUMAN_REVIEW=true
CITATION_MATCH_THRESHOLD=0.6

# ---- services -------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
STREAMLIT_PORT=8501
MAX_UPLOAD_MB=50
DEFAULT_AUDITOR_NAME=Research Auditor

# Streamlit talks to the service layer in-process by default. Set to true to
# route the UI through the FastAPI backend over HTTP instead.
USE_API=false
