# ---------------------------------------------------------------------------
# AuditAI (LLM-Assisted IT Audit Risk and Control Assessment System) - settings
#
# Copy to .env and edit.  NEVER commit a real .env or a real API key.
#   cp .env.example .env
# Every value below has a working default, so the application runs with no .env
# at all, fully offline, using the deterministic mock assistant.
# ---------------------------------------------------------------------------

# ===========================================================================
# QUICK START - the only lines most people change
# ===========================================================================
# Which assistant answers:
#   mock    - offline, rule-based, no API key, no network (default). Fine for
#             trying the tool; results measure the workflow, not a language model.
#   claude  - Anthropic Claude. Needs ANTHROPIC_API_KEY below.
#   openai  - any OpenAI-compatible endpoint (see the OPENAI section further down).
LLM_PROVIDER=mock
# Get a key at https://console.anthropic.com/settings/keys (only for LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Pre-fills the auditor name in the sidebar. Leave blank and the console asks for one;
# a blank name is never silently attributed to a review or a report.
DEFAULT_AUDITOR_NAME=

# ===========================================================================
# EVERYTHING ELSE - working defaults
# ===========================================================================

# ---- application ----------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
# Display name shown in the console; the long research title is fixed in code.
APP_SHORT_NAME=AuditAI

# ---- database -------------------------------------------------------------
# SQLite by default. The schema is portable; to move to PostgreSQL use e.g.
# DATABASE_URL=postgresql+psycopg://audit:password@localhost:5432/itaudit
DATABASE_URL=sqlite:///./data/audit.db
DB_ECHO=false

# ---- Claude (Anthropic) ----------------------------------------------------
# LLM_PROVIDER=claude plus ANTHROPIC_API_KEY (both in QUICK START) is all that is
# needed. If the key is missing the application falls back to the offline mock and
# says so loudly - in the log, in /health, on the Settings page and on every
# answer - so a mock run can never be mistaken for a real model run.
#
# Reasoning depth: low | medium | high | xhigh | max. Audit reasoning is
# non-trivial, so "high" is the default; use "low" for cheap bulk experiment runs.
ANTHROPIC_EFFORT=high
# Adaptive thinking. Current Claude models reject a fixed token budget and reject
# `temperature` outright, so depth is controlled by effort, not sampling.
ANTHROPIC_THINKING=true
# Only for Anthropic-compatible gateways/proxies. NOTE: if this variable is already
# exported in your shell (common if you use other Anthropic tooling) it will be
# picked up automatically - check the Settings page to see the URL actually in use.
# ANTHROPIC_BASE_URL=

# ---- OpenAI-compatible endpoints (LLM_PROVIDER=openai) ---------------------
# Covers OpenAI itself, Azure gateways, OpenRouter, Ollama, vLLM, LM Studio,
# llama.cpp server and anything else speaking the OpenAI protocol. Which one is
# selected by LLM_BASE_URL, not by code.
LLM_MODEL=gpt-4o-mini            # (openai provider only) Claude uses ANTHROPIC_MODEL
# LLM_API_KEY=                   # leave unset for local servers that need no key
# LLM_BASE_URL=                  # e.g. http://localhost:11434/v1  (Ollama)
#                                # e.g. http://localhost:8000/v1   (vLLM)
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2500
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
# Ask the endpoint for a JSON-schema-constrained response when it supports it.
LLM_USE_JSON_MODE=true

# ---- assessment safety rails ---------------------------------------------
# Human review is mandatory by design; leaving this true is the supported mode.
FORCE_HUMAN_REVIEW=true
CITATION_MATCH_THRESHOLD=0.6

# ---- services -------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
# `python run.py` binds the console to 127.0.0.1 on this port. Change it when the
# port is taken; containers get their port from $PORT via scripts/start_ui.sh.
STREAMLIT_PORT=8501
MAX_UPLOAD_MB=50

# The console talks to the service layer in-process by default. Set true to route
# it through the FastAPI backend over HTTP (needed when UI and API are deployed as
# separate services). The console honours this value when it reads
# settings.use_api; `python run.py all` forces false so the UI stays
# self-sufficient if the API dies.
USE_API=false

# ---- deployment ------------------------------------------------------------
# Public URLs of the deployed services. Left unset, nothing changes and the app
# runs on localhost. Set them when deploying so no hostname is baked into code.
# PUBLIC_APP_URL=https://your-app.streamlit.app
# PUBLIC_API_URL=https://your-api.onrender.com

# Extra origins permitted by CORS, comma-separated. Localhost is always allowed
# in development.
# CORS_ALLOW_ORIGINS=https://your-app.streamlit.app,https://audit.example.edu

# Set true on any internet-facing deployment: stops trusting localhost and
# permits ONLY the origins named above.
CORS_RESTRICT_TO_CONFIGURED=false

# ===========================================================================
# RESEARCH LEVERS (leave alone unless running experiments)
# ===========================================================================

# ---- retrieval (RAG) ------------------------------------------------------
RETRIEVAL_STRATEGY=HYBRID        # KEYWORD | VECTOR | HYBRID
RETRIEVAL_TOP_K=12
RETRIEVAL_CANDIDATE_K=60
RETRIEVAL_MIN_SCORE=0.0

# ---- chunking -------------------------------------------------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
TABLE_ROWS_PER_CHUNK=25
MAX_EVIDENCE_CHARS=24000
RAW_EVIDENCE_CHAR_BUDGET=24000

# ---- mock assistant -------------------------------------------------------
# Fraction of MOCK assessments that deliberately fabricate a citation or an
# unsupported claim, so the validation layer can be exercised and measured
# offline. MUST stay 0.0 for normal use; the console reports any other value.
MOCK_HALLUCINATION_RATE=0.0
MOCK_SEED=1337

# ---- embeddings -----------------------------------------------------------
# "local"  - stateless hashing vectoriser. Deterministic, no network.
# "openai" - remote embedding endpoint (uses EMBEDDING_API_KEY / _BASE_URL).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# ---- evaluation output ----------------------------------------------------
# EVALUATION_OUTPUT_DIR=./data/evaluation
